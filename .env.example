# Copy to .env and fill in real values. Never commit .env.
# Add a line here (name only, no value) whenever the code reads a new variable.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DATABASE_URL=

# Shared feed (Supabase). These two go in app/.env.local (Vite only reads env files in app/).
# Supabase → Project Settings → API. Without them the feed saves posts in your browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
